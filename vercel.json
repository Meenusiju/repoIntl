{
  "version": 2,
  "installCommand": "npm install --production=false",
  "functions": {
    "api/index.ts": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}

