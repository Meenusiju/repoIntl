# Anthropic API
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# GitHub Integration
# GITHUB_TOKEN: used for cloning; only required for private repos (not needed
# for Phase 1's public-repo-only flow, but reserved for future use).
GITHUB_TOKEN=ghp_YOUR_PAT_TOKEN_HERE
# GITHUB_WEBHOOK_SECRET: required to receive live GitHub webhooks at
# POST /api/webhooks/github. Set this to the same value you configure in
# GitHub's repo Settings > Webhooks > Secret. Requests with a missing or
# invalid X-Hub-Signature-256 are rejected with 401. Deliveries are verified
# via HMAC-SHA256 over the raw request body.
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Chroma Vector Store (falls back to a local JSON store automatically if
# no real Chroma server is reachable at this URL)
CHROMA_URL=http://localhost:8000

# Server
PORT=3010
NODE_ENV=development
EGRESS_LOCKED=false
